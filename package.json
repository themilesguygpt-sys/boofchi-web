{
  "name": "boofchi-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "catalog:audit": "node scripts/audit-boofchi-source.mjs",
    "catalog:import": "node scripts/import-boofchi-demo.mjs",
    "catalog:validate": "node scripts/validate-demo-catalog.mjs",
    "cf:build": "pnpm --filter @boofchi/web cf:build",
    "cf:deploy": "pnpm --filter @boofchi/web cf:deploy",
    "cf:preview": "pnpm --filter @boofchi/web cf:preview",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint scripts",
    "type-check": "turbo run type-check",
    "validate": "pnpm catalog:validate && pnpm lint && pnpm type-check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "html-to-text": "10.0.1",
    "sharp": "0.35.3",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
